#!/bin/sh

# The commit message file
MSG_FILE=$1

# Detect staged files
STAGED=$(git diff --cached --name-only)

# Decide prefix based on folder
if echo "$STAGED" | grep -q "^website/"; then
    PREFIX="website: "
elif echo "$STAGED" | grep -q "^backend/"; then
    PREFIX="backend: "
elif echo "$STAGED" | grep -q "^news/"; then
    PREFIX="news: "
elif echo "$STAGED" | grep -q "^app/"; then
    PREFIX="app: "
else
    PREFIX="misc: "
fi

# Only add prefix if not already present
if [ -n "$PREFIX" ] && ! grep -q "^$PREFIX" "$MSG_FILE"; then
    sed -i "1s/^/$PREFIX/" "$MSG_FILE"
fi
